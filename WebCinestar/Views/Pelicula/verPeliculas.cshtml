@model List<WebCinestar.Models.Pelicula>

@{
    ViewData["Title"] = "verPeliculas";
    Layout = "~/Views/Shared/_CinestarLayout.cshtml";
}

<br />
<h1>@(ViewBag.idEstado == 1 ? "Cartelera" : "Próximos Estrenos")</h1>
<br />

@foreach (var pelicula in Model)
{
    <div class="contenido-pelicula">
        <div class="datos-pelicula">
            <h2>@pelicula.Titulo</h2><br />
            <p>@pelicula.Sinopsis</p>
            <br />
            <div class="boton-pelicula">
                <a href='@Url.Action("verPelicula", "Pelicula", new { idPelicula = pelicula.id })'>
                    <img src="~/img/varios/btn-mas-info.jpg" width="120" height="30" alt="Ver info" />
                </a>
            </div>
            <div class="boton-pelicula">
                <a href="https://www.youtube.com/watch?v=@pelicula.Link" target="_blank">
                    <img src="~/img/varios/btn-trailer.jpg" width="120" height="30" alt="Ver trailer" />
                </a>
            </div>
        </div>
        <img src="~/img/pelicula/@(pelicula.id).jpg" width="160" height="226" /><br /><br />
    </div>
}